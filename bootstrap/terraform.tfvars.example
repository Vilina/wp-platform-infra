aws_region   = "eu-central-1"
project_name = "wp-platform"

# bucket_name = "my-explicit-bucket-name"

noncurrent_version_retention_days = 90

environments          = ["dev", "prod"]
github_repository     = "Vilina/wp-platform-infra"
github_default_branch = "main"

# Only if the repo uses GitHub's immutable OIDC subjects. Get it from:
# gh api repos/<owner>/<repo>/actions/oidc/customization/sub  (sub_claim_prefix)
# github_oidc_subject_prefix = "repo:<owner>@<owner_id>/<repo>@<repo_id>"

# Set to false if the account already has a token.actions.githubusercontent.com provider.
create_oidc_provider = true

apply_role_policy_arns = {
  dev  = ["arn:aws:iam::aws:policy/ReadOnlyAccess"]
  prod = ["arn:aws:iam::aws:policy/AdministratorAccess"]
}

# Gives these apply roles a "may only touch resources tagged Environment=<env>" policy.
# Their apply_role_policy_arns entry should then be ReadOnlyAccess, not AdministratorAccess.
tag_scoped_apply_environments = {
  dev = {
    name_prefix = "dev-wp"
    ssm_path    = "/platform/dev"
    dns_names   = ["dev.example.com", "*.dev.example.com"]
  }
}

tags = {
  Owner = "platform-team"
}
